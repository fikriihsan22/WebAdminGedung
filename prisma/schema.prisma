// use prisma-next

enum UserRole {
  @@type("pg/text@1")

  CENTRAL_ADMIN
  BUILDING_ADMIN
}

enum EventSession {
  @@type("pg/text@1")

  DAY
  NIGHT
}

enum PaymentStatus {
  @@type("pg/text@1")

  UNPAID
  DP_PAID
  PAID
}

enum EventStatus {
  @@type("pg/text@1")

  ACTIVE
  CANCELLED
}

model User {
  id            String    @id @default(uuid())
  name          String
  username      String    @unique
  pinHash       String
  role          UserRole  @default(BUILDING_ADMIN)
  buildingId    String?
  building      Building? @relation(fields: [buildingId], references: [id])
  isActive      Boolean   @default(true)
  createdEvents Event[]   @relation("EventCreatedBy")
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     temporal.updatedAt()
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Building {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
  users     User[]
  events    Event[]
}

model Event {
  id            String        @id @default(uuid())
  buildingId    String
  building      Building      @relation(fields: [buildingId], references: [id])
  clientName    String
  eventDate     DateTime
  session       EventSession
  totalAmount   Int
  downPayment   Int           @default(0)
  finalPayment  Int           @default(0)
  paymentStatus PaymentStatus @default(UNPAID)
  eventStatus   EventStatus   @default(ACTIVE)
  createdById   String
  createdBy     User          @relation("EventCreatedBy", fields: [createdById], references: [id])
  cancelReason  String?
  createdAt     DateTime      @default(now())
  updatedAt     temporal.updatedAt()

  @@index([buildingId, eventDate])
  @@index([eventDate, session, eventStatus, paymentStatus])
}
